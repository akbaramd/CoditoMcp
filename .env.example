# Local development only. Production uses /data/projects/codito/.env (mode 0600).
PUBLIC_BASE_URL=https://codito.akbaramd.ir
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-generate-at-least-64-random-characters
DJANGO_ALLOWED_HOSTS=codito.akbaramd.ir,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://codito.akbaramd.ir
FORWARDED_ALLOW_IPS=127.0.0.1
DATABASE_URL=postgresql://codito:change-me@127.0.0.1:5432/codito
REDIS_URL=redis://127.0.0.1:6379/0
METRICS_BEARER_TOKEN=change-me-generate-random
# Base64 of an unencrypted RSA private-key PEM. Keep this on one line.
OIDC_RSA_PRIVATE_KEY_B64=replace-with-base64-encoded-rsa-private-key-pem
DESKTOP_OAUTH_CLIENT_ID=codito-windows-agent
CHATGPT_CLIENT_METADATA_HOSTS=chatgpt.com,openai.com
# OAuth access: 1 hour; rotating refresh: 90 days idle after paired access expiry.
OAUTH_ACCESS_TOKEN_EXPIRE_SECONDS=3600
OAUTH_REFRESH_TOKEN_EXPIRE_SECONDS=7776000
DEVICE_OFFLINE_AFTER_SECONDS=75
DEVICE_QUEUE_LIMIT=32
