# Copy to /data/projects/codito/.env and chmod 0600. Never commit real values.
CODITO_RELAY_IMAGE=docker.wa-nezam.org/codito/relay:0.1.0-0123456789ab
BIND_ADDRESS=192.168.200.39
PUBLIC_BASE_URL=https://codito.akbaramd.ir
DJANGO_ALLOWED_HOSTS=codito.akbaramd.ir
CSRF_TRUSTED_ORIGINS=https://codito.akbaramd.ir
# Comma-separated Nginx/OPNsense source IPs/CIDRs. Never use * in production.
FORWARDED_ALLOW_IPS=192.168.200.34
DJANGO_SECRET_KEY=replace-with-64-plus-random-characters
# Dedicated `codito` database on the existing `postgres` container/network.
DATABASE_URL=postgresql://codito:replace-with-url-encoded-password@postgres:5432/codito
# Dedicated logical database 1 on the existing authenticated `redis` container/network.
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379/1
CODITO_REDIS_DB=1
METRICS_BEARER_TOKEN=replace-with-random-bearer-token
# Base64 of an unencrypted RSA private-key PEM. Keep this on one line.
OIDC_RSA_PRIVATE_KEY_B64=replace-with-base64-encoded-rsa-private-key-pem
DESKTOP_OAUTH_CLIENT_ID=codito-windows-agent
CHATGPT_CLIENT_METADATA_HOSTS=chatgpt.com,openai.com
OAUTH_ACCESS_TOKEN_EXPIRE_SECONDS=3600
OAUTH_REFRESH_TOKEN_EXPIRE_SECONDS=7776000
