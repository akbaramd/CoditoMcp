{
  "$defs": {
    "DeviceReadEntry": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file",
            "directory",
            "blocked"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "DeviceReadEntry",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/device-read-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "encoding": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Encoding"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/DeviceReadEntry"
      },
      "maxItems": 500,
      "title": "Entries",
      "type": "array"
    },
    "newline": {
      "anyOf": [
        {
          "enum": [
            "lf",
            "crlf",
            "cr",
            "mixed",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Newline"
    },
    "next_line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Line"
    },
    "next_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    },
    "numbered_text": {
      "default": "",
      "title": "Numbered Text",
      "type": "string"
    },
    "operation": {
      "enum": [
        "list_directory",
        "read_file"
      ],
      "title": "Operation",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "scope_path": {
      "title": "Scope Path",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "operation",
    "scope_path",
    "path"
  ],
  "title": "DeviceReadResult",
  "type": "object"
}
