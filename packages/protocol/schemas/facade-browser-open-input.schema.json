{
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-browser-open-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "browser": {
      "default": "default",
      "enum": [
        "default",
        "firefox"
      ],
      "title": "Browser",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "url": {
      "description": "HTTP/HTTPS destination; no credentials or custom schemes.",
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "url",
    "purpose"
  ],
  "title": "BrowserOpenInput",
  "type": "object"
}
