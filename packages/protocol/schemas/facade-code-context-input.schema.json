{
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-context-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "character": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Character",
      "type": "integer"
    },
    "include_diagnostics": {
      "default": true,
      "title": "Include Diagnostics",
      "type": "boolean"
    },
    "include_references": {
      "default": true,
      "title": "Include References",
      "type": "boolean"
    },
    "line": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Line",
      "type": "integer"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "source_context_lines": {
      "default": 5,
      "maximum": 50,
      "minimum": 0,
      "title": "Source Context Lines",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "purpose",
    "path",
    "line",
    "character"
  ],
  "title": "CodeContextFacadeInput",
  "type": "object"
}
