{
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-dependencies-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "direction": {
      "default": "direct",
      "enum": [
        "all",
        "direct",
        "transitive"
      ],
      "title": "Direction",
      "type": "string"
    },
    "max_results": {
      "default": 100,
      "maximum": 500,
      "minimum": 1,
      "title": "Max Results",
      "type": "integer"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "purpose"
  ],
  "title": "CodeDependenciesFacadeInput",
  "type": "object"
}
