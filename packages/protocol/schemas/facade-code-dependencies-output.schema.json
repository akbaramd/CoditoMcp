{
  "$defs": {
    "CodeDependenciesResult": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Captured At",
          "type": "string"
        },
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/DependencyInfo"
          },
          "maxItems": 500,
          "title": "Dependencies",
          "type": "array"
        },
        "freshness": {
          "default": "unknown",
          "enum": [
            "verified",
            "stale",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "operation": {
          "const": "code_dependencies",
          "default": "code_dependencies",
          "title": "Operation",
          "type": "string"
        },
        "precision": {
          "$ref": "#/$defs/Precision",
          "default": "unavailable"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind",
          "default": "none"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "verified_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "captured_at"
      ],
      "title": "CodeDependenciesResult",
      "type": "object"
    },
    "DependencyInfo": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "direct",
          "enum": [
            "direct",
            "transitive",
            "dev"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "DependencyInfo",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "Precision": {
      "enum": [
        "exact",
        "structural",
        "heuristic",
        "unavailable"
      ],
      "title": "Precision",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "lsp",
        "graph",
        "manifest",
        "none"
      ],
      "title": "ProviderKind",
      "type": "string"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-dependencies-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeDependenciesResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[CodeDependenciesResult]",
  "type": "object"
}
