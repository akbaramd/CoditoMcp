{
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-impact-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "character": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Character"
    },
    "line": {
      "anyOf": [
        {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "max_nodes": {
      "default": 50,
      "maximum": 500,
      "minimum": 1,
      "title": "Max Nodes",
      "type": "integer"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "purpose",
    "path"
  ],
  "title": "CodeImpactFacadeInput",
  "type": "object"
}
