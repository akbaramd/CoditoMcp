{
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-implementations-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "character": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Character",
      "type": "integer"
    },
    "line": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Line",
      "type": "integer"
    },
    "max_results": {
      "default": 100,
      "maximum": 500,
      "minimum": 1,
      "title": "Max Results",
      "type": "integer"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "purpose",
    "path",
    "line",
    "character"
  ],
  "title": "CodeImplementationsFacadeInput",
  "type": "object"
}
