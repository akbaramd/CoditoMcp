{
  "$defs": {
    "TypeHierarchyDirection": {
      "enum": [
        "supertypes",
        "subtypes",
        "both"
      ],
      "title": "TypeHierarchyDirection",
      "type": "string"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-code-type-hierarchy-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "character": {
      "description": "One-based Unicode character position.",
      "maximum": 100000,
      "minimum": 1,
      "title": "Character",
      "type": "integer"
    },
    "direction": {
      "$ref": "#/$defs/TypeHierarchyDirection",
      "default": "both",
      "description": "Supertypes, subtypes, or both directions."
    },
    "line": {
      "description": "One-based type line.",
      "maximum": 10000000,
      "minimum": 1,
      "title": "Line",
      "type": "integer"
    },
    "max_depth": {
      "default": 3,
      "description": "Maximum traversal depth.",
      "maximum": 10,
      "minimum": 1,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_nodes": {
      "default": 50,
      "description": "Maximum graph nodes returned.",
      "maximum": 200,
      "minimum": 1,
      "title": "Max Nodes",
      "type": "integer"
    },
    "path": {
      "description": "Project-relative source file containing the type.",
      "title": "Path",
      "type": "string"
    },
    "project_id": {
      "description": "Opaque project ID returned by projects_list; never send a local path.",
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "description": "Concise user-facing reason shown in Windows approval and local activity history.",
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "purpose",
    "path",
    "line",
    "character"
  ],
  "title": "CodeTypeHierarchyFacadeInput",
  "type": "object"
}
