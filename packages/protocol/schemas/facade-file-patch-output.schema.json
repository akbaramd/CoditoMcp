{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "PatchConflict": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "base_hash_missing",
            "base_hash_mismatch",
            "context_not_found",
            "context_ambiguous",
            "path_exists",
            "path_missing",
            "destination_exists",
            "invalid_section",
            "policy_denied"
          ],
          "title": "Code",
          "type": "string"
        },
        "hunk_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hunk Index"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "section_index": {
          "minimum": 0,
          "title": "Section Index",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "section_index",
        "code",
        "message"
      ],
      "title": "PatchConflict",
      "type": "object"
    },
    "PatchedFile": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "new_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Sha256"
        },
        "old_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Sha256"
        },
        "operation": {
          "enum": [
            "add",
            "update",
            "delete",
            "move"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "path"
      ],
      "title": "PatchedFile",
      "type": "object"
    },
    "ProjectApplyPatchResult": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/PatchConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/PatchedFile"
          },
          "title": "Files",
          "type": "array"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "journal_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal Id"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "idempotency_key",
        "dry_run",
        "applied"
      ],
      "title": "ProjectApplyPatchResult",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-file-patch-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectApplyPatchResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[ProjectApplyPatchResult]",
  "type": "object"
}
