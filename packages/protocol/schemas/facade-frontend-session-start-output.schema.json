{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FrontendDevServerInfo": {
      "additionalProperties": false,
      "properties": {
        "health": {
          "const": "ready",
          "default": "ready",
          "title": "Health",
          "type": "string"
        },
        "ownership": {
          "enum": [
            "managed",
            "reused"
          ],
          "title": "Ownership",
          "type": "string"
        }
      },
      "required": [
        "ownership"
      ],
      "title": "FrontendDevServerInfo",
      "type": "object"
    },
    "FrontendSessionStartResult": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "description": "Bare HTTP loopback origin selected by the Windows agent.",
          "maxLength": 2048,
          "pattern": "^http://(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]\\.?|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(?:(?:0{1,4}:){7}0{0,3}1|(?:0{1,4}(?::0{1,4}){0,5})?::0{0,3}1)\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/?(?![\\s\\S])",
          "title": "Base Url",
          "type": "string"
        },
        "dev_server": {
          "$ref": "#/$defs/FrontendDevServerInfo"
        },
        "operation": {
          "const": "session_start",
          "default": "session_start",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "url": {
          "description": "Current HTTP loopback page URL without query or fragment.",
          "maxLength": 2048,
          "pattern": "^http://(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]\\.?|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(?:(?:0{1,4}:){7}0{0,3}1|(?:0{1,4}(?::0{1,4}){0,5})?::0{0,3}1)\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\\\?#\\x00-\\x1f\\x7f]*)?(?![\\s\\S])",
          "title": "Url",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/FrontendViewport"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "session_id",
        "base_url",
        "url",
        "viewport",
        "dev_server"
      ],
      "title": "FrontendSessionStartResult",
      "type": "object"
    },
    "FrontendViewport": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 900,
          "maximum": 2048,
          "minimum": 240,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "default": 1440,
          "maximum": 2048,
          "minimum": 320,
          "title": "Width",
          "type": "integer"
        }
      },
      "title": "FrontendViewport",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-frontend-session-start-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrontendSessionStartResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[FrontendSessionStartResult]",
  "type": "object"
}
