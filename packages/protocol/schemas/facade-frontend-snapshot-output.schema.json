{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FrontendConsoleEntry": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "level",
        "text"
      ],
      "title": "FrontendConsoleEntry",
      "type": "object"
    },
    "FrontendElement": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "$ref": "#/$defs/FrontendRect"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Classes",
          "type": "array"
        },
        "element_id": {
          "pattern": "^e[1-9][0-9]{0,7}$",
          "title": "Element Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "focused": {
          "default": false,
          "title": "Focused",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^e[1-9][0-9]{0,7}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "tag": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
          "title": "Tag",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "visible": {
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "element_id",
        "tag",
        "box",
        "visible"
      ],
      "title": "FrontendElement",
      "type": "object"
    },
    "FrontendNetworkIssue": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ],
          "title": "Method",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "url": {
          "description": "HTTP(S) URL or relative resource path with query and fragment redacted.",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "method",
        "url"
      ],
      "title": "FrontendNetworkIssue",
      "type": "object"
    },
    "FrontendRect": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "FrontendRect",
      "type": "object"
    },
    "FrontendSnapshotMetadata": {
      "additionalProperties": false,
      "description": "Model-visible snapshot data after PNG bytes move to MCP ImageContent.",
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "console": {
          "items": {
            "$ref": "#/$defs/FrontendConsoleEntry"
          },
          "maxItems": 100,
          "title": "Console",
          "type": "array"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/FrontendElement"
          },
          "maxItems": 500,
          "title": "Elements",
          "type": "array"
        },
        "height": {
          "maximum": 2048,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Mime Type",
          "type": "string"
        },
        "network": {
          "items": {
            "$ref": "#/$defs/FrontendNetworkIssue"
          },
          "maxItems": 100,
          "title": "Network",
          "type": "array"
        },
        "operation": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Operation",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "title": {
          "maxLength": 1024,
          "title": "Title",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "description": "Current HTTP loopback page URL without query or fragment.",
          "maxLength": 2048,
          "pattern": "^http://(?:[Ll][Oo][Cc][Aa][Ll][Hh][Oo][Ss][Tt]\\.?|127(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|\\[(?:(?:0{1,4}:){7}0{0,3}1|(?:0{1,4}(?::0{1,4}){0,5})?::0{0,3}1)\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\\\?#\\x00-\\x1f\\x7f]*)?(?![\\s\\S])",
          "title": "Url",
          "type": "string"
        },
        "viewport": {
          "$ref": "#/$defs/FrontendViewport"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Warnings",
          "type": "array"
        },
        "width": {
          "maximum": 2048,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "captured_at",
        "sha256",
        "project_id",
        "session_id",
        "snapshot_id",
        "url",
        "title",
        "viewport",
        "elements"
      ],
      "title": "FrontendSnapshotMetadata",
      "type": "object"
    },
    "FrontendViewport": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 900,
          "maximum": 2048,
          "minimum": 240,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "default": 1440,
          "maximum": 2048,
          "minimum": 320,
          "title": "Width",
          "type": "integer"
        }
      },
      "title": "FrontendViewport",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-frontend-snapshot-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrontendSnapshotMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[FrontendSnapshotMetadata]",
  "type": "object"
}
