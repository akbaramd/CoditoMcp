{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ProjectRegistrationRequestResult": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "request_add_project",
          "default": "request_add_project",
          "title": "Operation",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "const": "pending_local_selection",
          "default": "pending_local_selection",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "title"
      ],
      "title": "ProjectRegistrationRequestResult",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-project-add-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectRegistrationRequestResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[ProjectRegistrationRequestResult]",
  "type": "object"
}
