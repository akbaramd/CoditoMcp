{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "invalid_request",
        "unauthenticated",
        "unauthorized",
        "resource_mismatch",
        "scope_missing",
        "rate_limited",
        "project_not_found",
        "device_offline",
        "device_revoked",
        "link_revoked",
        "queue_full",
        "deadline_exceeded",
        "path_invalid",
        "path_outside_project",
        "path_changed",
        "reparse_point_forbidden",
        "hardlink_mutation_forbidden",
        "file_not_found",
        "file_too_large",
        "encoding_unsupported",
        "hash_mismatch",
        "patch_invalid",
        "patch_conflict",
        "idempotency_conflict",
        "approval_required",
        "approval_denied",
        "approval_expired",
        "sandbox_unavailable",
        "shell_not_found",
        "shell_not_running",
        "output_limit_exceeded",
        "outcome_unknown",
        "screenshot_unavailable",
        "desktop_unavailable",
        "cancelled",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ShellOutputChunk": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr",
            "system"
          ],
          "title": "Stream",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "sequence",
        "stream",
        "text"
      ],
      "title": "ShellOutputChunk",
      "type": "object"
    },
    "ShellPollResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "poll",
          "default": "poll",
          "title": "Action",
          "type": "string"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/ShellOutputChunk"
          },
          "title": "Chunks",
          "type": "array"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "next_sequence_cursor": {
          "minimum": 0,
          "title": "Next Sequence Cursor",
          "type": "integer"
        },
        "output_truncated": {
          "default": false,
          "title": "Output Truncated",
          "type": "boolean"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending_approval",
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "outcome_unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "job_id",
        "state",
        "chunks",
        "next_sequence_cursor"
      ],
      "title": "ShellPollResult",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "$id": "https://codito.akbaramd.ir/schemas/v1/facade-shell-status-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShellPollResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "title": "FacadeToolResult[ShellPollResult]",
  "type": "object"
}
