PUBLIC_BASE_URL=https://codito.akbaramd.ir
DJANGO_ALLOWED_HOSTS=codito.akbaramd.ir
CSRF_TRUSTED_ORIGINS=https://codito.akbaramd.ir
DJANGO_DEBUG=false
SECURE_SSL_REDIRECT=true
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DATABASE_URL=postgresql://codito:replace-me@postgres:5432/codito
POSTGRES_SSLMODE=disable
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
# Optional separate Redis; defaults to REDIS_URL. Authentication endpoints fail closed on errors.
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1.0
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_INVITATION_REQUESTS=20
RATE_LIMIT_PASSWORD_RESET_REQUESTS=20
RATE_LIMIT_OAUTH_AUTHORIZE_REQUESTS=60
RATE_LIMIT_OAUTH_TOKEN_REQUESTS=30
RATE_LIMIT_DEVICE_ENROLL_REQUESTS=10
RATE_LIMIT_DEVICE_TICKET_REQUESTS=30
METRICS_BEARER_TOKEN=replace-with-a-random-token
# Base64 of an unencrypted RSA private-key PEM (single line; required in production).
OIDC_RSA_PRIVATE_KEY_B64=replace-with-base64-encoded-rsa-private-key-pem
DESKTOP_OAUTH_CLIENT_ID=codito-windows-agent
CHATGPT_CLIENT_METADATA_HOSTS=chatgpt.com,openai.com
# Bounded synchronous ORM lanes per relay worker.
DATABASE_ASYNC_WORKERS=8
REDIS_ASYNC_MAX_CONNECTIONS=64
REDIS_ASYNC_POOL_WAIT_SECONDS=5
LOG_LEVEL=INFO
